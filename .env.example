# Local RAG Mini Configuration
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.2

# Rate Limiting Presets: strict (10 QPM), standard (30 QPM), relaxed (100 QPM)
RATE_LIMIT_PRESET=standard

# Chunking & Retrieval Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3

# HTTP Server Options (Optional Microservice Mode)
HOST=127.0.0.1
PORT=8000
